# Required on Vercel
DATABASE_URL=
JWT_SECRET=

# Razorpay (Dashboard → API Keys). Until these are set, trial still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

APP_URL=https://goldhour-chi.vercel.app
API_PORT=8788

# Optional — HQ mail. Without these, FormSubmit/Web3forms still try.
# Gmail: Google Account → Security → 2-Step → App passwords → Mail.
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=
WEB3FORMS_ACCESS_KEY=

# Indian mobile OTP (2Factor). Set on Vercel — do not commit the live key.
TWOFACTOR_API_KEY=
